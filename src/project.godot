; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiny Adventure"
run/main_scene="res://scenes/test/test_scene.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ToolManager="*res://scripts/globals/tool_manager.gd"
ItemRegistry="*res://scripts/globals/item_registry.gd"
InventoryManager="*res://scripts/globals/inventory_manager.gd"
DayNightCycleManager="*res://scripts/globals/day_night_cycle_manager.gd"
SaveGameManager="*res://scripts/globals/save_game_manager.gd"
CameraManager="*res://scripts/globals/camera_manager.gd"
Global="*res://scripts/globals/global.gd"
ResourceSpawnManager="*res://scripts/globals/resource_spawn_manager.gd"
CurrencyManager="*res://scripts/globals/currency_manager.gd"
Drop="*res://scripts/globals/drop.gd"
BuildingManager="*res://scripts/globals/building_manager.gd"
BuildingPlacer="*res://scripts/building/building_placer.gd"
AnimalPlacer="*res://scripts/animal/animal_placer.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameDialogueManager="*res://scripts/globals/game_dialogue_manager.gd"
AnimationManager="*res://scripts/globals/animation_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://dialogues/": "teal",
"res://resources/": "purple",
"res://scenes/": "green",
"res://scripts/": "yellow",
"res://tile_sets/": "pink"
}

[global_group]

navigation_polygon_source_geometry_group=""
player=""
camera=""
collectable=""

